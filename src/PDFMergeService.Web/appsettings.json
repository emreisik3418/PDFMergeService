{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PdfSettings": {
    "DefaultLogoPath": "wwwroot/assets/logo/company-logo.png",
    "MaxFileSizeMB": 50,
    "MaxFileCount": 20,
    "LimitsFilePath": "App_Data/pdf-limits.json",
    "TempFolder": "wwwroot/temp"
  },
  "SharePointSettings": {
    "ServiceUrl": "",
    "SiteUrl": "",
    "UserId": 0,
    "Username": "",
    "Password": "",
    "WebPathOptions": [
      { "Label": "Angus", "Value": "angus" },
      { "Label": "Performans", "Value": "performans" }
    ],
    "BulkWebPath": "performans",
    "BulkUploadRules": [
      { "FileSuffix": "BÖLGE MÜDÜRLÜĞÜ", "FolderSuffix": "", "RootPath": "/BolgeRaporlari", "PeriodFolderFormat": "{YIL} - {CEYREK}. Çeyrek" },
      { "FileSuffix": "KURUMSAL ŞUBESİ", "FolderSuffix": "KURUMSAL ŞUBELER", "RootPath": "/Kurumsal Şubeler", "PeriodFolderFormat": "{YIL} - {CEYREK}. Çeyrek" },
      { "FileSuffix": "TİCARİ ŞUBESİ", "FolderSuffix": "", "RootPath": "/BolgeRaporlari", "PeriodFolderFormat": "{YIL} - {CEYREK}. Çeyrek" },
      { "FileSuffix": "ÖZEL {AD} ŞUBESİ", "FolderSuffix": "", "RootPath": "/BolgeRaporlari", "PeriodFolderFormat": "{YIL} - {CEYREK}. Çeyrek" },
      { "FileSuffix": "{AD} ŞUBESİ", "FolderSuffix": "", "RootPath": "/Bireysel ve Karma Şubeler/{BOLGE}", "PeriodFolderFormat": "{DONEM}" }
    ],
    "BulkPathOverrides": []
  },
  "Ldap": {
    "Domain": "",
    "Server": "",
    "Port": 389,
    "ContainerDn": "",
    "UseSsl": false
  },
  "Exadata": {
    "ConnectionString": "",
    "AuthorizationQuery": "SELECT USERNAME, ROLE FROM SCHEMA.APP_AUTHORIZED_USERS WHERE UPPER(USERNAME) = UPPER(:Username)",
    "CommandTimeoutSeconds": 15
  },
  "Authentication": {
    "UseMockProviders": false,
    "UseConfigAuthorization": true
  },
  "AuthorizedUsers": {
    "Users": [
      { "Username": "", "Role": "Admin" }
    ]
  },
  "ActivityLog": {
    "LogFolder": "App_Data/logs"
  },
  "DrivePathConfig": {
    "FilePath": "App_Data/drive-paths.json"
  }
}
