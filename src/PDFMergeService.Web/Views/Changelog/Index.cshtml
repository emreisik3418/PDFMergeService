@model IReadOnlyList<PDFMergeService.Web.Models.ChangelogEntry>
@{
    ViewData["Title"] = "Yenilikler";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");

    (string Label, string Css, string Icon) TypeInfo(string type) => type switch
    {
        "fix" => ("Düzeltme", "changelog-tag-fix", "bi-wrench-adjustable"),
        "improvement" => ("İyileştirme", "changelog-tag-improvement", "bi-arrow-up-circle"),
        _ => ("Yeni", "changelog-tag-new", "bi-stars")
    };
}

<div class="row g-4 justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold text-primary d-flex align-items-center">
                    <span class="card-header-icon"><i class="bi bi-stars"></i></span>Yenilikler
                </h5>
            </div>
            <div class="card-body p-4">

                <p class="text-muted small mb-4">
                    ReportDeck'e eklenen yeni özellikler, iyileştirmeler ve düzeltmeler; en yeni güncelleme en üstte.
                </p>

                @if (Model.Count == 0)
                {
                    <div class="alert alert-light border text-muted small mb-0">
                        <i class="bi bi-info-circle me-1"></i>Henüz kayıt yok.
                    </div>
                }

                <div class="changelog">
                    @for (var e = 0; e < Model.Count; e++)
                    {
                        var entry = Model[e];
                        <section class="changelog-entry">
                            <div class="d-flex flex-wrap align-items-baseline gap-2 mb-3">
                                <h6 class="fw-semibold mb-0">@entry.Title</h6>
                                <span class="text-muted small">@entry.Date.ToString("d MMMM yyyy", culture)</span>
                                @if (e == 0)
                                {
                                    <span class="badge rounded-pill text-bg-primary">Son güncelleme</span>
                                }
                            </div>

                            <ul class="list-unstyled mb-0">
                                @foreach (var item in entry.Items)
                                {
                                    var info = TypeInfo(item.Type);
                                    <li class="changelog-item">
                                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                            <span class="changelog-tag @info.Css"><i class="bi @info.Icon"></i>@info.Label</span>
                                            <span class="fw-medium">@item.Title</span>
                                            @if (item.AdminOnly)
                                            {
                                                <span class="badge text-bg-dark fw-normal"><i class="bi bi-shield-lock me-1"></i>Yönetici</span>
                                            }
                                        </div>
                                        <p class="text-muted small mb-0">@item.Description</p>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Kullanıcı son güncellemeyi gördü: menüdeki "yeni" işaretini kaldır.
        try { localStorage.setItem('reportdeck.changelog.seen', '@(Model.FirstOrDefault()?.Id)'); } catch { }
        document.querySelectorAll('[data-changelog-dot]').forEach(dot => dot.classList.add('d-none'));
    </script>
}
