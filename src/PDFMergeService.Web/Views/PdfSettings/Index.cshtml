@model PDFMergeService.Core.Models.PdfMergeLimits
@using PDFMergeService.Core.Models
@{
    ViewData["Title"] = "PDF Ayarları";
}

<div class="row g-4 justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold text-primary d-flex align-items-center">
                    <span class="card-header-icon"><i class="bi bi-sliders"></i></span>PDF Birleştirme Ayarları
                </h5>
            </div>
            <div class="card-body p-4">

                <div class="alert alert-info border-0 py-2 px-3 mb-4 small">
                    <i class="bi bi-info-circle me-1"></i>
                    PDF Birleştir sayfasındaki yükleme sınırlarıdır. Birleştirme kullanıcının tarayıcısında yapıldığı için
                    çok yüksek değerler (ör. yüzlerce büyük dosya) tarayıcının belleğini zorlayabilir.
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input type="number" id="maxFileCount" class="form-control" value="@Model.MaxFileCount"
                               min="@PdfMergeLimits.MinFileCount" max="@PdfMergeLimits.MaxFileCountLimit" step="1" />
                        <label for="maxFileCount">En Fazla Dosya Sayısı</label>
                    </div>
                    <div class="form-text">@PdfMergeLimits.MinFileCount – @PdfMergeLimits.MaxFileCountLimit arası.</div>
                </div>

                <div class="mb-4">
                    <div class="form-floating">
                        <input type="number" id="maxFileSizeMB" class="form-control" value="@Model.MaxFileSizeMB"
                               min="@PdfMergeLimits.MinFileSizeMB" max="@PdfMergeLimits.MaxFileSizeMBLimit" step="1" />
                        <label for="maxFileSizeMB">Dosya Başına En Fazla Boyut (MB)</label>
                    </div>
                    <div class="form-text">@PdfMergeLimits.MinFileSizeMB – @PdfMergeLimits.MaxFileSizeMBLimit MB arası.</div>
                </div>

                <button type="button" id="pdfSettingsSaveBtn" class="btn btn-primary btn-lg w-100 shadow-sm">
                    <span id="pdfSettingsSaveBtnNormal"><i class="bi bi-floppy me-2"></i>Kaydet</span>
                    <span id="pdfSettingsSaveBtnLoading" class="d-none">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>Kaydediliyor...
                    </span>
                </button>
                <div id="pdfSettingsResult" class="small mt-2" role="status" aria-live="polite"></div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Ayrı bir JS dosyasına bağlı kalmasın diye sayfa içinde; sonuç butonun altında da yazılır. *@
    <script>
        (() => {
            const maxFileCount   = document.getElementById('maxFileCount');
            const maxFileSizeMB  = document.getElementById('maxFileSizeMB');
            const saveBtn        = document.getElementById('pdfSettingsSaveBtn');
            const saveBtnNormal  = document.getElementById('pdfSettingsSaveBtnNormal');
            const saveBtnLoading = document.getElementById('pdfSettingsSaveBtnLoading');
            const result         = document.getElementById('pdfSettingsResult');

            function showResult(message, ok) {
                result.className = 'small mt-2 ' + (ok ? 'text-success' : 'text-danger');
                result.textContent = message;
                try {
                    const container = document.getElementById('toastContainer');
                    const el = document.createElement('div');
                    el.className = 'toast align-items-center border-0 shadow text-bg-' + (ok ? 'success' : 'danger');
                    el.setAttribute('role', 'alert');
                    el.innerHTML = '<div class="d-flex"><div class="toast-body"></div>' +
                        '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
                    el.querySelector('.toast-body').textContent = message;
                    container.appendChild(el);
                    new bootstrap.Toast(el, { delay: 5000 }).show();
                    el.addEventListener('hidden.bs.toast', () => el.remove());
                } catch (e) {
                    console.warn('Bildirim gösterilemedi', e);
                }
            }

            function setSaving(saving) {
                saveBtn.disabled = saving;
                saveBtnNormal.classList.toggle('d-none', saving);
                saveBtnLoading.classList.toggle('d-none', !saving);
            }

            saveBtn.addEventListener('click', async () => {
                const payload = {
                    maxFileCount: parseInt(maxFileCount.value, 10),
                    maxFileSizeMB: parseInt(maxFileSizeMB.value, 10)
                };

                if (Number.isNaN(payload.maxFileCount) || Number.isNaN(payload.maxFileSizeMB)) {
                    showResult('Lütfen geçerli sayılar girin.', false);
                    return;
                }

                setSaving(true);
                try {
                    const res = await fetch('@Url.Action("Save", "PdfSettings")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json().catch(() => ({}));

                    if (res.ok) showResult(data.message || 'PDF ayarları kaydedildi.', true);
                    else showResult(data.error || `Kaydetme başarısız (HTTP ${res.status}).`, false);
                } catch (e) {
                    console.error('PDF ayarları kaydedilemedi', e);
                    showResult('Sunucuya ulaşılamadı: ' + (e && e.message ? e.message : e), false);
                } finally {
                    setSaving(false);
                }
            });
        })();
    </script>
}
