@model PDFMergeService.Core.Models.DrivePathConfig
@using System.Text.Json
@{
    ViewData["Title"] = "Drive Yolları";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

<div class="row g-4 justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold text-primary d-flex align-items-center">
                    <span class="card-header-icon"><i class="bi bi-signpost-split"></i></span>Drive Aktarım Yolları
                </h5>
            </div>
            <div class="card-body p-4">

                <div class="alert alert-info border-0 py-2 px-3 mb-4 small">
                    <i class="bi bi-info-circle me-1"></i>
                    Kaydettiğiniz değişiklikler Drive Aktarım sayfasındaki seçeneklere hemen yansır,
                    uygulamayı yeniden başlatmaya gerek yoktur.
                </div>

                <!-- Site Alt Yolları (Tekli Yükleme) -->
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <h6 class="fw-semibold mb-0">Site Alt Yolları (webPath)</h6>
                        <div class="form-text mt-0">Tekli Yükleme sekmesindeki site seçenekleri.</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-add-row="webPathOptions">
                        <i class="bi bi-plus-lg me-1"></i>Ekle
                    </button>
                </div>
                <div class="table-responsive mb-4">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr class="text-muted small">
                                <th style="width: 40%;">Görünen Ad</th>
                                <th>Değer</th>
                                <th style="width: 1%;"></th>
                            </tr>
                        </thead>
                        <tbody id="webPathOptionsBody"></tbody>
                    </table>
                </div>

                <!-- Toplu Yükleme -->
                <h6 class="fw-semibold mb-2">Toplu Yükleme</h6>
                <div class="mb-3" style="max-width: 24rem;">
                    <div class="form-floating">
                        <input type="text" id="bulkWebPath" class="form-control" placeholder="performans" />
                        <label for="bulkWebPath">Site Alt Yolu (webPath)</label>
                    </div>
                    <div class="form-text">Toplu yüklemede tüm dosyalar bu siteye gönderilir.</div>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <div class="fw-medium">Toplu Yükleme Kuralları</div>
                        <div class="form-text mt-0">
                            Hedef: <code>Ana Klasör/&lt;Klasör Adı&gt;/&lt;Dönem Klasörü&gt;</code>.
                            <ul class="mb-0 ps-3 mt-1">
                                <li>
                                    <strong>Dosya Adı Kalıbı</strong> dosya adında aranır; <code>{AD}</code> şube/bölge adını yakalar.
                                    <code>{AD}</code> yazmazsanız ad ifadenin önündedir: <code>KURUMSAL ŞUBESİ</code>
                                    → "BAŞKENT KURUMSAL ŞUBESİ". Ad ortadaysa: <code>ÖZEL {AD} ŞUBESİ</code> → "ÖZEL BAŞKENT ŞUBESİ".
                                </li>
                                <li>
                                    <strong>Klasör Adı</strong> boşsa dosya adındaki ifade aynen kullanılır.
                                    <code>{AD}</code> içeriyorsa şablondur (<code>{AD} KURUMSAL ŞUBELER</code>); içermiyorsa adın arkasına eklenir.
                                </li>
                                <li>
                                    <strong>Dönem Klasörü</strong>nde <code>{YIL}</code> ve <code>{CEYREK}</code> dosya adındaki yıl/çeyrekle
                                    doldurulur; <code>{DONEM}</code> dosyadaki dönemi aynen yazar (<code>2026 - 3. Çeyrek</code> ya da
                                    <code>2026 - Ağustos</code>). <code>{CEYREK}</code> içeren kurallar aylık dosyalara uygulanmaz.
                                    Boş bırakılırsa dönem klasörü açılmaz.
                                </li>
                                <li>
                                    <strong>Ana Klasör</strong> ve <strong>Klasör Adı</strong>'nda <code>{BOLGE}</code>, Drive Aktarım'da
                                    <em>Klasör Seç</em> ile yüklenen dosyanın bulunduğu klasörün adıdır (büyük harfle). Ör. Bireysel ve Karma:
                                    kalıp <code>{AD} ŞUBESİ</code>, Ana Klasör <code>/Bireysel ve Karma Şubeler/{BOLGE}</code>, Dönem <code>{DONEM}</code>.
                                    Bölge bilinmeyen yüklemelerde bu kural atlanır.
                                </li>
                                <li>
                                    Ana Klasör site alt yolunu içermemeli (webPath <code>performans</code> ise <code>/Kurumsal Şubeler</code> yazın).
                                    Büyük/küçük harf ve İ/ı farkı gözetilmez; birden fazla kural eşleşirse en uzun kalıp kazanır.
                                </li>
                            </ul>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary text-nowrap ms-3" data-add-row="bulkUploadRules">
                        <i class="bi bi-plus-lg me-1"></i>Ekle
                    </button>
                </div>
                <div class="table-responsive mb-3">
                    <table class="table table-sm align-middle" style="min-width: 760px;">
                        <thead>
                            <tr class="text-muted small">
                                <th>Dosya Adı Kalıbı</th>
                                <th>Klasör Adı</th>
                                <th>Ana Klasör</th>
                                <th>Dönem Klasörü</th>
                                <th style="width: 1%;"></th>
                            </tr>
                        </thead>
                        <tbody id="bulkUploadRulesBody"></tbody>
                    </table>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <div class="fw-medium">Özel Eşleştirmeler</div>
                        <div class="form-text mt-0">
                            Kurallara uymayan özel durumlar için: dosya adı <strong>Aranacak Metin</strong>'i içeriyorsa dosya
                            doğrudan <strong>Hedef Klasör</strong>'e yüklenir. Kurallardan önce denenir. Hedef klasörde
                            <code>{YIL}</code> ve <code>{CEYREK}</code> kullanılabilir; ör. <code>/Genel Müdürlük/Yönetim Kurulu/{YIL}</code>.
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary text-nowrap ms-3" data-add-row="bulkPathOverrides">
                        <i class="bi bi-plus-lg me-1"></i>Ekle
                    </button>
                </div>
                <div class="table-responsive mb-3">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr class="text-muted small">
                                <th style="width: 40%;">Aranacak Metin</th>
                                <th>Hedef Klasör</th>
                                <th style="width: 1%;"></th>
                            </tr>
                        </thead>
                        <tbody id="bulkPathOverridesBody"></tbody>
                    </table>
                </div>

                <div class="border rounded-3 p-3 mb-4 bg-body-tertiary">
                    <label for="rulePreviewInput" class="form-label fw-medium small mb-1">
                        <i class="bi bi-eye me-1"></i>Kuralları ve eşleştirmeleri dene
                    </label>
                    <div class="d-flex flex-wrap gap-2">
                        <input type="text" id="rulePreviewInput" class="form-control form-control-sm flex-grow-1" style="min-width: 16rem; width: auto;"
                               value="ÖZEL BAŞKENT ŞUBESİ 2026 - 3. Çeyrek.pdf" aria-label="Dosya adı" />
                        <input type="text" id="rulePreviewRegion" class="form-control form-control-sm" style="max-width: 12rem;"
                               placeholder="Bölge (ör. Akdeniz)" aria-label="Bölge" title="{BOLGE} içeren kurallar için: Klasör Seç'te dosyanın bulunduğu klasör" />
                    </div>
                    <div class="small mt-2" id="rulePreviewResult"></div>
                    <div class="form-text">Henüz kaydedilmemiş değişiklikler de önizlemeye yansır.</div>
                </div>

                <button type="button" id="drivePathsSaveBtn" class="btn btn-primary btn-lg w-100 shadow-sm">
                    <span id="drivePathsSaveBtnNormal"><i class="bi bi-floppy me-2"></i>Kaydet</span>
                    <span id="drivePathsSaveBtnLoading" class="d-none">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>Kaydediliyor...
                    </span>
                </button>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>window.drivePathConfig = @Html.Raw(JsonSerializer.Serialize(Model, jsonOptions));</script>
    <script src="~/js/drive-path-resolver.js" asp-append-version="true"></script>
    <script src="~/js/drive-paths.js" asp-append-version="true"></script>
}
