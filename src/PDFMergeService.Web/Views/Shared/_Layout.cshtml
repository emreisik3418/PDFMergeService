<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ReportDeck</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark app-navbar shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="PdfMerge" asp-action="Index">
                <svg width="26" height="26" viewBox="0 0 100 100" class="me-2" aria-hidden="true" focusable="false">
                    <rect x="28" y="20" width="44" height="58" rx="9" fill="#FBF6F3" opacity="0.35" transform="rotate(-16 50 78)" />
                    <rect x="28" y="20" width="44" height="58" rx="9" fill="#FBF6F3" opacity="0.68" transform="rotate(-8 50 78)" />
                    <rect x="28" y="20" width="44" height="58" rx="9" fill="#FBF6F3" />
                    <rect x="36" y="34" width="22" height="4" rx="2" fill="#1F1714" />
                    <rect x="36" y="44" width="28" height="4" rx="2" fill="#1F1714" />
                    <rect x="36" y="54" width="18" height="4" rx="2" fill="#1F1714" />
                </svg>
                ReportDeck
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav app-nav-pills mx-lg-auto my-2 my-lg-0">
                    <li class="nav-item">
                        <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PdfMerge" ? "active" : "")"
                           asp-controller="PdfMerge" asp-action="Index">
                            <i class="bi bi-files"></i>PDF Birleştir
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FolderMerge" ? "active" : "")"
                           asp-controller="FolderMerge" asp-action="Index">
                            <i class="bi bi-folder2-open"></i>Klasör Birleştirme
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DriveTransfer" ? "active" : "")"
                           asp-controller="DriveTransfer" asp-action="Index">
                            <i class="bi bi-cloud-upload"></i>Drive Aktarım
                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ActivityLog" ? "active" : "")"
                               asp-controller="ActivityLog" asp-action="Index">
                                <i class="bi bi-clock-history"></i>Aktivite Logları
                            </a>
                        </li>
                    }
                </ul>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav ms-lg-3 align-items-lg-center">
                        <li class="nav-item d-flex align-items-center app-user-badge small me-2 mb-2 mb-lg-0">
                            <i class="bi bi-person-circle me-1"></i>@User.Identity!.Name
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-light app-logout-btn">
                                    <i class="bi bi-box-arrow-right me-1"></i>Çıkış
                                </button>
                            </form>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <div class="container py-4 app-content-fade">
        @RenderBody()
    </div>

    <!-- Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    <footer class="bg-white border-top py-3 mt-4">
        <div class="container text-center text-muted small">
            &copy; 2026 ReportDeck &mdash; Tüm hakları saklıdır.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
