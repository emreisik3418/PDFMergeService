@inject PDFMergeService.Web.Services.ChangelogService Changelog
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ReportDeck</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/@@fontsource-variable/inter@5.1.0/index.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/polish.css" asp-append-version="true" />
</head>
<body class="bg-light">

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        string ActiveIf(string controller) => currentController == controller ? "active" : "";
    }

    <nav class="navbar navbar-dark app-navbar shadow-sm sticky-top">
        <div class="container-fluid px-3 px-lg-4">
            <div class="d-flex align-items-center gap-2 min-w-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="btn app-menu-btn position-relative" type="button"
                            data-bs-toggle="offcanvas" data-bs-target="#appSideMenu" aria-controls="appSideMenu" aria-label="Menüyü aç">
                        <i class="bi bi-list"></i>
                        <span class="app-nav-dot app-nav-dot-btn d-none" data-changelog-dot></span>
                    </button>
                }
                <a class="navbar-brand fw-bold d-flex align-items-center me-0" asp-controller="PdfMerge" asp-action="Index">
                    <svg width="26" height="26" viewBox="0 0 100 100" class="me-2" aria-hidden="true" focusable="false">
                        <rect x="28" y="20" width="44" height="58" rx="9" fill="#FBF6F3" opacity="0.35" transform="rotate(-16 50 78)" />
                        <rect x="28" y="20" width="44" height="58" rx="9" fill="#FBF6F3" opacity="0.68" transform="rotate(-8 50 78)" />
                        <rect x="28" y="20" width="44" height="58" rx="9" fill="#FBF6F3" />
                        <rect x="36" y="34" width="22" height="4" rx="2" fill="#1F1714" />
                        <rect x="36" y="44" width="28" height="4" rx="2" fill="#1F1714" />
                        <rect x="36" y="54" width="18" height="4" rx="2" fill="#1F1714" />
                    </svg>
                    ReportDeck
                </a>
                @if (ViewData["Title"] is string pageTitle)
                {
                    <span class="app-page-title d-none d-sm-inline text-truncate">@pageTitle</span>
                }
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="app-user-badge small d-none d-sm-inline-flex align-items-center">
                        <i class="bi bi-person-circle me-1"></i>@User.Identity!.Name
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-light app-logout-btn text-nowrap">
                            <i class="bi bi-box-arrow-right me-1"></i>Çıkış
                        </button>
                    </form>
                </div>
            }
        </div>
    </nav>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="offcanvas offcanvas-start app-side-menu" tabindex="-1" id="appSideMenu" aria-labelledby="appSideMenuLabel">
            <div class="offcanvas-header app-side-menu-header">
                <h5 class="offcanvas-title fw-bold mb-0" id="appSideMenuLabel">ReportDeck</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column">
                <div class="app-side-user d-sm-none mb-3">
                    <i class="bi bi-person-circle me-1"></i>@User.Identity!.Name
                </div>

                <div class="app-side-section">Araçlar</div>
                <nav class="nav flex-column mb-3">
                    <a class="app-side-link @ActiveIf("PdfMerge")" asp-controller="PdfMerge" asp-action="Index">
                        <i class="bi bi-files"></i>PDF Birleştir
                    </a>
                    <a class="app-side-link @ActiveIf("FolderMerge")" asp-controller="FolderMerge" asp-action="Index">
                        <i class="bi bi-folder2-open"></i>Klasör Birleştirme
                    </a>
                    <a class="app-side-link @ActiveIf("DriveTransfer")" asp-controller="DriveTransfer" asp-action="Index">
                        <i class="bi bi-cloud-upload"></i>Drive Aktarım
                    </a>
                </nav>

                @if (User.IsInRole("Admin"))
                {
                    <div class="app-side-section">Yönetim</div>
                    <nav class="nav flex-column mb-3">
                        <a class="app-side-link @ActiveIf("ActivityLog")" asp-controller="ActivityLog" asp-action="Index">
                            <i class="bi bi-clock-history"></i>Aktivite Logları
                        </a>
                        <a class="app-side-link @ActiveIf("DrivePathSettings")" asp-controller="DrivePathSettings" asp-action="Index">
                            <i class="bi bi-signpost-split"></i>Drive Yolları
                        </a>
                        <a class="app-side-link @ActiveIf("PdfSettings")" asp-controller="PdfSettings" asp-action="Index">
                            <i class="bi bi-sliders"></i>PDF Ayarları
                        </a>
                    </nav>
                }

                <div class="app-side-section">Bilgi</div>
                <nav class="nav flex-column">
                    <a class="app-side-link @ActiveIf("Changelog")" asp-controller="Changelog" asp-action="Index"
                       data-changelog-latest="@Changelog.GetLatestId(User.IsInRole("Admin"))">
                        <i class="bi bi-stars"></i>Yenilikler
                        <span class="app-side-new-badge d-none" data-changelog-dot>Yeni</span>
                    </a>
                </nav>
            </div>
        </div>
    }

    <div class="container py-4">
        @RenderBody()
    </div>

    <!-- Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    <footer class="bg-white border-top py-3 mt-4">
        <div class="container text-center text-muted small">
            &copy; 2026 ReportDeck &mdash; Tüm hakları saklıdır.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
