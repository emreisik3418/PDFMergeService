@model PDFMergeService.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - ReportDeck</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex align-items-center" style="min-height:100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="text-center mb-4">
                    <svg width="40" height="40" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
                        <rect x="28" y="20" width="44" height="58" rx="9" fill="#0d6efd" opacity="0.35" transform="rotate(-16 50 78)" />
                        <rect x="28" y="20" width="44" height="58" rx="9" fill="#0d6efd" opacity="0.68" transform="rotate(-8 50 78)" />
                        <rect x="28" y="20" width="44" height="58" rx="9" fill="#0d6efd" />
                        <rect x="36" y="34" width="22" height="4" rx="2" fill="#fff" />
                        <rect x="36" y="44" width="28" height="4" rx="2" fill="#fff" />
                        <rect x="36" y="54" width="18" height="4" rx="2" fill="#fff" />
                    </svg>
                    <h4 class="fw-bold mt-2 mb-0">ReportDeck</h4>
                </div>
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold mb-3">Giriş Yap</h5>
                        <form asp-controller="Account" asp-action="Login" method="post">
                            <input type="hidden" asp-for="ReturnUrl" />
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>
                            }
                            <div class="mb-3">
                                <label asp-for="Username" class="form-label small text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                                    <input asp-for="Username" class="form-control" autofocus autocomplete="username" />
                                </div>
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label small text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 mt-2">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Giriş Yap
                            </button>
                        </form>
                    </div>
                </div>
                <div class="text-center text-muted small mt-3">
                    &copy; 2026 ReportDeck
                </div>
            </div>
        </div>
    </div>
</body>
</html>
