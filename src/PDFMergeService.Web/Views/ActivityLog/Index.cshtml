@using PDFMergeService.Core.Enums
@model PDFMergeService.Web.ViewModels.ActivityLog.ActivityLogViewModel
@{
    ViewData["Title"] = "Aktivite Logları";

    string EventLabel(ActivityEventType type) => type switch
    {
        ActivityEventType.Login => "Giriş",
        ActivityEventType.Logout => "Çıkış",
        ActivityEventType.SingleMerge => "Tekli Birleştirme",
        ActivityEventType.FolderMerge => "Klasör Birleştirme",
        ActivityEventType.DriveTransfer => "Drive Aktarım",
        _ => type.ToString()
    };

    string EventBadgeClass(ActivityEventType type) => type switch
    {
        ActivityEventType.Login => "bg-success",
        ActivityEventType.Logout => "bg-secondary",
        ActivityEventType.SingleMerge => "bg-primary",
        ActivityEventType.FolderMerge => "bg-info text-dark",
        ActivityEventType.DriveTransfer => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom py-3">
        <h5 class="mb-0 fw-semibold text-primary">
            <i class="bi bi-clock-history me-2"></i>Aktivite Logları
        </h5>
    </div>
    <div class="card-body p-4">

        <form method="get" asp-action="Index" class="row g-2 align-items-end mb-4">
            <div class="col-auto">
                <label class="form-label small text-muted mb-1">Başlangıç</label>
                <input type="date" name="from" class="form-control form-control-sm"
                       value="@Model.From?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto">
                <label class="form-label small text-muted mb-1">Bitiş</label>
                <input type="date" name="to" class="form-control form-control-sm"
                       value="@Model.To?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto">
                <label class="form-label small text-muted mb-1">Kullanıcı</label>
                <input type="text" name="username" class="form-control form-control-sm"
                       placeholder="kullanıcı adı" value="@Model.Username" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm px-3">
                    <i class="bi bi-search me-1"></i>Filtrele
                </button>
            </div>
            <div class="col-auto">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">Temizle</a>
            </div>
        </form>

        @if (Model.Entries.Count == 0)
        {
            <div class="alert alert-light border text-muted small mb-0">
                <i class="bi bi-info-circle me-1"></i>Kayıt bulunamadı.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr class="text-muted small">
                            <th>Tarih</th>
                            <th>Kullanıcı</th>
                            <th>İşlem</th>
                            <th>Detay</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            <tr>
                                <td class="small text-nowrap">@entry.Timestamp.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="small">@entry.Username</td>
                                <td><span class="badge @EventBadgeClass(entry.EventType)">@EventLabel(entry.EventType)</span></td>
                                <td class="small text-muted">@entry.Detail</td>
                                <td>
                                    @if (entry.Success)
                                    {
                                        <span class="badge bg-success-subtle text-success border">Başarılı</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border">Başarısız</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="text-muted small mt-2">Toplam @Model.Entries.Count kayıt.</div>
        }
    </div>
</div>
